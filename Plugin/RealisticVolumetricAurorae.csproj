<Project Sdk="Microsoft.NET.Sdk">

  <!-- Realistic Volumetric Aurorae (RVA) — KSP 1.12 plugin: .NET Framework 4.8, references KSP's own DLLs from refs\ -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RealisticVolumetricAurorae</AssemblyName>
    <RootNamespace>RVA</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.1</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Configurations>Debug;Release;Dev</Configurations>
  </PropertyGroup>

  <!-- Dev build: every setting and debug control exposed (AURORA_DEV). Build this
       configuration for your own copy; ship Release, which keeps the dev-only
       settings at their built-in values and out of settings.cfg and the window. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);AURORA_DEV</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Copy these from <KSP>\KSP_x64_Data\Managed\ into the refs\ folder.
       Private=false means the build output is ONLY RealisticVolumetricAurorae.dll. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>refs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>refs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>refs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>refs\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>refs\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>refs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>refs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
